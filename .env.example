# Chave de API do provedor compatível com o OpenRouter. Obrigatória.
GLUM_API_KEY=coloque_sua_chave_aqui

# Modelo usado para escrever a mensagem de commit.
GLUM_MODEL=openrouter/auto

# Endereço base da API. Altere apenas para usar um provedor alternativo.
GLUM_BASE_URL=https://openrouter.ai/api/v1

# Processamento em duas etapas: resume cada arquivo antes de escrever a mensagem.
# Recomendado para contas com limite baixo de tokens.
GLUM_TWO_STEP=true

# Máximo de caracteres enviados por arquivo durante a etapa de resumo.
GLUM_MAX_CHUNK_CHARS=8000

# Máximo de caracteres lidos de cada arquivo novo antes de gerar uma prévia.
GLUM_MAX_FILE_CHARS=2000

# Máximo de arquivos novos considerados em uma execução. Use 0 para não limitar.
GLUM_MAX_FILES=50

# Máximo de caracteres do diff combinado. Use 0 para não limitar.
GLUM_MAX_DIFF_CHARS=100000

# Ignora os arquivos listados no .gitignore.
GLUM_IGNORE_GITIGNORED=true
